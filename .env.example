# -------------------------------------------------------------
# My Corbett Trip - Environment Variables Configuration
# -------------------------------------------------------------

# 1. Lead Notification Recipient (Where leads are delivered)
LEAD_NOTIFY_EMAIL=saleemwarsi89@gmail.com

# -------------------------------------------------------------
# 2. EMAIL PROVIDER - OPTION A: Nodemailer (Gmail / SMTP)
# -------------------------------------------------------------
# To use your own Gmail:
#   1. Go to Google Account -> Security -> 2-Step Verification (turn ON).
#   2. Under 2-Step Verification, scroll down to "App passwords".
#   3. Create an app password named "Corbett Website" (generates a 16-letter password).
#   4. Paste below:
GMAIL_USER=saleemwarsi89@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Or Custom SMTP (Hostinger / cPanel / Zoho / GoDaddy):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@mycorbetttrip.com
# SMTP_PASS=your_email_password
# SMTP_FROM="My Corbett Trip" <info@mycorbetttrip.com>

# -------------------------------------------------------------
# 3. EMAIL PROVIDER - OPTION B: Resend (Alternative to Nodemailer)
# -------------------------------------------------------------
# Free 3,000 emails/month at https://resend.com
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM_EMAIL=My Corbett Trip Leads <onboarding@resend.dev>

# -------------------------------------------------------------
# 4. (Optional) Telegram Instant Sound Alert on Mobile
# -------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# -------------------------------------------------------------
# 5. (Optional) Meta Conversions API (CAPI) for Ads
# -------------------------------------------------------------
# META_PIXEL_ID=
# META_CAPI_TOKEN=
