# -------------------------------------------------------------
# My Corbett Trip - Environment Variables Configuration
# -------------------------------------------------------------

# 1. Lead Notification Email (Where you want to receive new inquiries)
LEAD_NOTIFY_EMAIL=saleemwarsi89@gmail.com

# 2. Resend Email Service (Free 3,000 emails/mo at https://resend.com)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Email:
# - Leave default "onboarding@resend.dev" to send immediately without domain verification!
# - Or set to "My Corbett Trip Leads <leads@yourdomain.com>" once your domain is verified on Resend.
RESEND_FROM_EMAIL=My Corbett Trip Leads <onboarding@resend.dev>

# 3. (Optional) Telegram Instant Sound Alert on Mobile
# Create a bot via @BotFather on Telegram and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. (Optional) Meta Conversions API (CAPI) for Facebook/Instagram Ads
META_PIXEL_ID=
META_CAPI_TOKEN=
